# Configuracao do Servidor
PORT=8080
WEBHOOK_PATH=/webhook
PROXY_PORT=8081
AUTO_START_PROXY=true

# Autenticacao e Assinatura do 99Food
FOOD_99_APP_ID=
FOOD_99_APP_SECRET=
VALIDATE_SIGNATURE=true

# Fila Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_QUEUE_NAME=99food:events:queue
REDIS_QUEUE_PER_MERCHANT=false

# Backup e Armazenamento Permanente SQLite
SQLITE_DATA_DIR=./data/merchants

# Alertas de Erro via Telegram Bot API
TELEGRAM_ALERTS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Alertas de Erro via Email (SMTP)
EMAIL_ALERTS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=

# Logs de Execucao
LOGS_DIR=./logs
LOG_RETENTION_DAYS=60
