{
    "compilerOptions": {
        "lib": ["ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "moduleDetection": "force",
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "types": ["bun"],
        "skipLibCheck": true,
        "strict": false
    },
    "include": [
        "src/**/*",
        "tests/**/*"
    ],
    "exclude": [
        "node_modules"
    ]
}
